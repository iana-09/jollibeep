{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["hnd1"],
  "functions": {
    "api/dispatch.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "^/$", "dest": "/api/dispatch.php?__jolli_route=index.php" },
    { "src": "^/([a-zA-Z0-9_-]+\\.php)$", "dest": "/api/dispatch.php?__jolli_route=$1" }
  ]
}